# Eastern Religious Family
## Zoroastrianism Religion
mithra_religion = { # Iranian cult of Mithra
	{% if tfe %}
	# Exists in TFE as kitebacilweism (they reused the vanilla ID to represent "Mehrism/West Iranic paganism from RICE").
	INVALIDATED_BY = { kitebacilweism }
	{% else %}
	# Just making sure that if a mod adds mithra_religion, we don't replace it with our own.
	INVALIDATED_BY = { mithra_religion }
	{% endif %}

	main_rite = mithra_religion
	faith_details = {
		religion = zoroastrianism_religion
