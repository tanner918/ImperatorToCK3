## General Culture Events
###########################

# Notification Events
## Event notifying players of outcome of a culture split
### This event will likely mainly be used for "Proto-" cultures, that are meant to completely split to give way to more modern cultures (i.e. Proto-Slavic splitting into Wendish/Antean/Sclavenian)

### This event uses the following scopes, which should be set BEFORE the event gets triggered:
#### scope:parent_culture (required) - The parent culture that was being split (i.e. When Slavic splits into Wendish/Antean/Sclavenian, Slavic would be the parent_culture)
#### scope:main_culture_ruler (conditional) - If the parent_culture is not being forced to completely split, this scope saves whichever ruler of that culture had met the requirements to hold the culture together (i.e. The Slavic split into Wendish/Antean/Sclavenian can be prevented if there exists a Slavic Emperor/Hegemon that controls more than half of the Slavic counties. If they do exist, they'd be saved in this scope)

#### new_cultures [list] (conditional) - If the parent_culture ended up getting split, in any way, into new cultures (whether scripted or dynamic), this list should have those new cultures saved in it so they can be shown in the event's localization so players actually know what cultures appeared
#### changed_cultures [list] (conditional) - If there were any existing cultures that were changed as a result of the splitting event, they should be saved in this list (i.e. If a culture diverges/hybridizes off Slavic before it officially splits, it may have it's heritage/language changed to match the West/East/South Slavic split)

### From this, a character can be considered "involved/related" to the parent culture and it's split if their culture is either:
#### the parent culture;
#### in the "new_cultures" list;
#### or, in the "changed_cultures" list.

irtock3_culture_events.001 = {
	type = character_event
	title = irtock3_culture_events.001.t
	theme = culture_change

	left_portrait = {
		trigger = {
			exists = scope:main_culture_ruler
			scope:main_culture_ruler != scope:player_character
		}
		character = scope:main_culture_ruler
		animation = personality_honorable
	}
	right_portrait = {
		character = scope:player_character
		triggered_animation = {
			trigger = {
				exists = scope:main_culture_ruler
				scope:main_culture_ruler = scope:player_character
			}
			animation = personality_honorable
		}
		triggered_animation = {
			trigger = { exists = scope:involved_character }
			animation = thinking
		}
		triggered_animation = {
			trigger = { always = yes }
			animation = dismissal
		}
	}

	desc = {
		# Intro
		first_valid = {
			# Culture DIDN'T split
			triggered_desc = {
				trigger = { exists = scope:main_culture_ruler }
				desc = irtock3_culture_events.001.desc.intro.culture_didnt_split
			}
			
			# Culture DID split
			desc = irtock3_culture_events.001.desc.intro.culture_did_split
		}

		# Main Body
		## Opening
		first_valid = {
			# Your culture is related to the parent culture in some way
			triggered_desc = {
				trigger = { exists = scope:involved_character }
				desc = irtock3_culture_events.001.desc.body.opening_involved_character
			}

			# You have nothing to do with the cultures involved in the split
			desc = irtock3_culture_events.001.desc.body.opening_uninvolved_character
		}

		## Part 1
		first_valid = {
			# Culture DIDN'T split, you are the "main_culture_ruler"
			triggered_desc = {
				trigger = {
					exists = scope:main_culture_ruler
					this = scope:main_culture_ruler
				}
				desc = irtock3_culture_events.001.desc.body.part1_main_culture_ruler
			}

			# Culture DIDN'T split, you aren't the "main_culture_ruler"
			triggered_desc = {
				trigger = { exists = scope:main_culture_ruler }
				desc = irtock3_culture_events.001.desc.body.part1_culture_didnt_split
			}
			
			# Culture DID split
			desc = irtock3_culture_events.001.desc.body.part1_culture_did_split 
		}

		## Ending
		first_valid = {
			# Culture DIDN'T split, you are the "main_culture_ruler"
			triggered_desc = {
				trigger = {
					exists = scope:main_culture_ruler
					this = scope:main_culture_ruler
				}
				desc = irtock3_culture_events.001.desc.body.ending_main_culture_ruler
			}

			# Culture DIDN'T split, you are still the parent culture
			triggered_desc = {
				trigger = {
					exists = scope:main_culture_ruler
					culture = scope:parent_culture
				}
				desc = irtock3_culture_events.001.desc.body.ending_culture_didnt_split_parent_culture
			}

			# Culture DIDN'T split, you are a different but related culture
			triggered_desc = {
				trigger = {
					exists = scope:main_culture_ruler
					exists = scope:involved_character
				}
				desc = irtock3_culture_events.001.desc.body.ending_culture_didnt_split_different_culture
			}

			# Culture DIDN'T split, you are an uninvolved culture
			triggered_desc = {
				trigger = { exists = scope:main_culture_ruler }
				desc = irtock3_culture_events.001.desc.body.ending_culture_didnt_split_uninvolved
			}

			# Culture DID split, you are an involved culture
			triggered_desc = {
				trigger = { exists = scope:involved_character }
				desc = irtock3_culture_events.001.desc.body.ending_culture_did_split_involved
			}

			# Culture DID split, you are an uninvolved culture
			desc = irtock3_culture_events.001.desc.body.ending_culture_did_split_uninvolved
		}
	}

	immediate = {
		save_scope_as = player_character

		# Determine if the character is involved/related to the culture split
		if = {
			limit = {
				culture = {
					OR = {
						# You are the parent culture
						this = scope:parent_culture

						# Your culture was newly created from this split
						trigger_if = {
							limit = {
								any_in_list = { list = new_cultures }
							}
							is_in_list = new_cultures
						}
						trigger_else = { always = no }

						# You have an existing culture that was changed because of this split
						trigger_if = {
							limit = {
								any_in_list = { list = changed_cultures }
							}
							is_in_list = changed_cultures
						}
						trigger_else = { always = no }
					}
				}
			}
			save_scope_value_as = {
				name = involved_character
				value = yes
			}
		}

		# Display a list of the new/changed cultures from this culture split
		if = {
			limit = {
				OR = {
					any_in_list = { list = new_cultures }
					any_in_list = { list = changed_cultures }
				}
			}

			if = {
				limit = {
					culture = { is_in_list = new_cultures }
				}
				culture = { save_scope_as = new_character_culture }
				custom_tooltip = irtock3_culture_event_culture_changed_tt
			}

			custom_description_no_bullet = { text = irtock3_culture_event_new_cultures_list_effect }
			
			# Display a list of the new cultures created through this split
			if = {
				limit = {
					any_in_list = { list = new_cultures }
				}
				every_in_list = {
					list = new_cultures
					save_scope_as = temp_culture_scope
					custom_label = irtock3_culture_event_list_culture_name_tt
					clear_saved_scope = temp_culture_scope
				}
			}

			# Display a list of the existing cultures that were changed through this split
			if = {
				limit = {
					any_in_list = { list = changed_cultures }
				}
				every_in_list = {
					list = changed_cultures
					save_scope_as = temp_culture_scope
					custom_label = irtock3_culture_event_list_culture_name_tt2
					clear_saved_scope = temp_culture_scope
				}
			}
		}
	}

	option = {
		name = {
			trigger = { culture = scope:parent_culture }
			text = irtock3_culture_events.001.a.parent_culture
		}
		name = {
			trigger = {
				exists = scope:involved_character
				culture != scope:parent_culture
			}
			text = irtock3_culture_events.001.a.different_culture
		}
		name = {
			trigger = {
				NOT = { exists = scope:involved_character }
			}
			text = irtock3_culture_events.001.a.uninvolved
		}
	}
}


