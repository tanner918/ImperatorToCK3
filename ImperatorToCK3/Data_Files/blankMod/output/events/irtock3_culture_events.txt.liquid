# Last updated: CK3 1.19.0.6
namespace = irtock3_culture_events

###########################
## Scripted Effects/Triggers
###########################

# This effect will be used to automatically get lists of all the counties and characters that will be affected by a culture split
## INPUTS:
### scope:parent_culture (required) - The parent culture being split (i.e. When Slavic splits into Wendish/Antean/Sclavenian, Slavic would be the parent_culture)

## OUTPUTS:
### parent_culture_counties [list] - A list of all counties that have the given parent_culture
### parent_culture_characters [list] - A list of all characters that have the given parent_culture
### relevant_players [list] - A list of some players to be given notifications regarding this culture split (depending on how the split event is setup, more players may be added later)

scripted_effect get_all_culture_counties_characters_effect = {
	scope:parent_culture = {
		every_culture_county = {
			add_to_list = parent_culture_counties

			# Start getting together a list of all players close enough to get the notification event
			holder ?= {
				every_player = {
					limit = {
						NOT = { is_in_list = relevant_players }
						in_diplomatic_range = prev
					}
					add_to_list = relevant_players
				}
			}
		}
	}
	every_living_character = {
		limit = { culture = scope:parent_culture }
		add_to_list = parent_culture_characters

		if = {
			limit = { is_landed = yes }
			every_player = {
				limit = {
					NOT = { is_in_list = relevant_players }
					in_diplomatic_range = prev
				}
				add_to_list = relevant_players
			}
		}
	}
}


